# Supabase Postgres connection strings.
# Use the pooled URL for runtime DATABASE_URL and the direct URL for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/modelrate"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/modelrate"

# Public site origin used by sitemap, robots and canonical metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional local/preview switch for production-like env validation.
MODELRATE_STRICT_ENV="false"

# Supabase Auth for production admin login.
# Local development bootstraps ADMIN_EMAILS when these are empty.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Comma-separated administrator emails seeded into admin_users.
ADMIN_EMAILS="admin@example.com"

# Private operational secrets.
CRON_SECRET="replace-me"
CLICK_HASH_SALT="replace-me-with-random-string"

# Optional observability.
SENTRY_DSN=""
